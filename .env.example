# Export these variables in your shell; .env is not loaded automatically.
ROBODOJO_ROOT=/absolute/path/to/RoboDojo
ROBOT_EVAL_SIM_PYTHON=/absolute/path/to/robodojo-env/bin/python
# Optional: use an existing pinned Astra checkout.
# ROBOT_EVAL_ASTRA_ROOT=/absolute/path/to/astra_policy
# Supply your own provider credential locally; never commit it.
# OPENAI_API_KEY=
