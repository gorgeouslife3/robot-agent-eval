{
  "model": "gpt-6-astra",
  "base_url": "https://YOUR-PROVIDER/v1",
  "wire_api": "responses",
  "api_key_file": "secrets/api-key.json",
  "api_key_json_field": "OPENAI_API_KEY",
  "reasoning_effort": "xhigh",
  "request_timeout_s": 180,
  "max_model_calls_per_episode": 20,
  "max_total_tokens_per_episode": 2000000,
  "max_episode_wall_s": 420,
  "max_decisions": 60,
  "images_max_edge": 480,
  "allow_model_fallback": false,
  "use_task_skill": true,
  "max_output_tokens_per_request": 8192,
  "ablation": {
    "perception": "sam_depth",
    "estimator": "cloud",
    "recovery": true,
    "action_backend": "geometry_dls",
    "refresh": "stage"
  }
}
